rules_version = '2';

// Firebase Storage Security Rules for DORAH FASHIONS (dorafashions.online)
service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'markniaras@gmail.com';
    }

    // Product images: Publicly readable for storefront visitors, writeable only by verified administrators
    match /products/{fileName} {
      allow read: if true;
      allow write: if isVerifiedAdmin() &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
